NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nailbabe

# Generate separate random values for both secrets. Do not commit real secrets.
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret

# Required only for sending nail-artist invitation emails.
SMTP_USER=
SMTP_PASS=
